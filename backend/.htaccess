Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve internal folders or setup files directly
    RewriteRule ^(lib|storage)(/|$) - [F,L]
    RewriteRule ^schema\.sql$ - [F,L]

    # Customer document file:  /vehicle1/photo  /vehicle1/rc  ...
    RewriteRule ^(vehicle[0-9]+)/(photo|insurance|rc|pollution)/?$ file.php?slug=$1&doc=$2 [L,QSA]

    # Customer page:  /vehicle1
    RewriteRule ^(vehicle[0-9]+)/?$ view.php?slug=$1 [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Referrer-Policy "no-referrer"
</IfModule>
